{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Environment": "Development",
      "Application": "Ficticia.Api.Host"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Literate, Serilog.Sinks.Console",
          "applyThemeToRedirectedOutput": true,
          "outputTemplate": "[{Timestamp:HH:mm:ss.fff} {Level:u3}] [{Component}] [{TraceId}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "PeopleDb": "Server=localhost,1433;Database=FicticiaPeople;User Id=sa;Password=Your_password123;TrustServerCertificate=True;",
    "IdentityDb": "Server=localhost,1433;Database=FicticiaIdentity;User Id=sa;Password=Your_password123;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Issuer": "Ficticia.Api",
    "Audience": "Ficticia.Web",
    "Key": "SUPER_LONG_DEV_KEY_CHANGE_ME_1234567890",
    "ExpiresMinutes": 60
  },
  "OpenAI": {
    "ApiKey": "",
    "Model": "gpt-4o-mini",
    "BaseUrl": "https://api.openai.com/v1",
    "EnableFallbackDictionary": true,
    "NormalizeConfidenceThreshold": 0.85
  },
  "RiskRules": {
    "BaseScore": 10,
    "Age_18_30": 5,
    "Age_31_45": 15,
    "Age_46_60": 30,
    "Age_61_plus": 45,
    "Smoker": 20,
    "Hypertension": 15,
    "Diabetes": 25,
    "HeartDisease": 35,
    "LowMax": 39,
    "MediumMax": 69
  }
}
