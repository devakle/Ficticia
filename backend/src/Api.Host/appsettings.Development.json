{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Environment": "Development",
      "Application": "Ficticia.Api.Host"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Literate, Serilog.Sinks.Console",
          "applyThemeToRedirectedOutput": true,
          "outputTemplate": "[{Timestamp:HH:mm:ss.fff} {Level:u3}] [{Component}] [{TraceId}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "PeopleDb": "Server=localhost,11433;Database=FicticiaPeople;User Id=sa;Password=Your_password123;TrustServerCertificate=True;",
    "IdentityDb": "Server=localhost,11433;Database=FicticiaIdentity;User Id=sa;Password=Your_password123;TrustServerCertificate=True;"
  },
  "Redis": {
    "ConnectionString": "localhost:16379"
  },
  "Jwt": {
    "Issuer": "Ficticia.Api",
    "Audience": "Ficticia.Web",
    "Key": "SUPER_LONG_DEV_KEY_CHANGE_ME_1234567890",
    "ExpiresMinutes": 60
  },
  "OpenAI": {
    "ApiKey": "",
    "Model": "gpt-4o-mini",
    "BaseUrl": "https://api.openai.com/v1",
    "EnableFallbackDictionary": true,
    "NormalizeConfidenceThreshold": 0.85
  }
}
