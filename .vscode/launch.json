{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Api.Host",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "prepare-api-debug",
      "postDebugTask": "docker-down",
      "program": "${workspaceFolder}/backend/src/Api.Host/bin/Debug/net10.0/Api.Host.dll",
      "cwd": "${workspaceFolder}/backend/src/Api.Host",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "Debug Angular (Chrome)",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "npm: start - frontend",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/frontend",
      "sourceMapPathOverrides": {
        "webpack:///./*": "${webRoot}/*",
        "webpack:///*": "${webRoot}/*"
      }
    }
  ]
}
